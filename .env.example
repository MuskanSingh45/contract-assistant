# Copy to .env and adjust. Never commit .env.

# --- Backend
APP_ENV=development
DATABASE_PATH=data/app.db
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:8080   # comma-separated; any localhost/127.0.0.1 port is also allowed
UPCOMING_WINDOW_DAYS=60
# Public deployment only: one private database per browser (X-Workspace-ID). Off locally.
WORKSPACES=false
WORKSPACE_DIR=data/workspaces
MAX_NEW_WORKSPACES_PER_HOUR=30      # per caller address
MAX_ANALYSES_PER_HOUR=20            # per caller address and per workspace (protects the model quota)
NOTIFY_URL=                         # optional: e.g. https://ntfy.sh/<private-topic>; phone alert per new visitor
LOG_LEVEL=INFO                    # DEBUG also logs analysis-status polling and model calls
LOG_FILE=data/logs/backend.log    # rotating (5 MB x 3); empty = console only
LOG_FORMAT=text                   # text, or json = one JSON object per line (machine-readable)

# --- AI (see docs/ai/model-config.md)
LLM_PROVIDER=ollama                 # primary: ollama (local, default) or groq (hosted; the online deployment)
LLM_FALLBACK_PROVIDER=              # optional: groq = use Groq only when Ollama is down (needs GROQ_API_KEY)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_SECONDS=300
EXTRACTION_WINDOW_TOKENS=           # empty = 6000 for ollama, 2500 for groq (free-tier token limit)

# Only when groq is the primary or the fallback. Put the key in .env (git-ignored) or the host's dashboard, never in git.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Frontend (Vite reads VITE_* from frontend/.env)
VITE_API_BASE_URL=http://localhost:8000/api
